{
  "version": 2,
  "kind": "duckx-theme",
  "theme": {
    "name": "Catppuccin Mocha",
    "type": "Dark",
    "accent": "#89b4fa",
    "border": "#313244",
    "panel_shadow_opacity": 0.35,
    "canvas": {
      "bg": "#1e1e2e",
      "grid": "#45475a"
    },
    "panel": {
      "bg": "#181825",
      "opacity": 1,
      "blur": 0
    },
    "handle": {
      "handle_color": "#89b4fa",
      "handle_border": "#1e1e2e",
      "selection_width": 1
    },
    "toolbar": {
      "bg": "#45475a"
    },
    "field": {
      "bg": "#1e1e2e",
      "border": "#313244",
      "hover_bg": "#585b70"
    },
    "button": {
      "bg": "#313244",
      "hover_bg": "#585b70",
      "active_bg": "#313244",
      "bg_opacity": 0,
      "hover_bg_opacity": 1,
      "active_bg_opacity": 1,
      "idle_fg": "#bac2de",
      "active_fg": "#89b4fa",
      "shadow_opacity": 0.0,
      "danger_fg": "#a6adc8",
      "danger_hover_bg": "#f38ba8",
      "danger_active_bg": "#eba0ac",
      "danger_hover_fg": "#ffffff",
      "danger_active_fg": "#ffffff"
    },
    "shadow": {
      "floating_x": 0,
      "floating_y": 10,
      "floating_blur": 30,
      "dock_x": 2,
      "dock_y": 0,
      "dock_blur": 12,
      "modal_x": 0,
      "modal_y": 16,
      "modal_blur": 48
    },
    "overlay": {
      "color": "#04070c",
      "backdrop_opacity": 0.44
    },
    "text": {
      "primary": "#bac2de",
      "secondary": "#bac2de",
      "muted": "#6c7086",
      "active": "#89b4fa"
    },
    "snackbar": {
      "bg": "#45475a"
    },
    "slider": {
      "active_bg": "#cba6f7",
      "thumb_bg": "#ffffff",
      "thumb_radius": 999
    },
    "switch": {
      "active_bg": "#89b4fa"
    },
    "scrollbar": {
      "track": "#313244",
      "thumb": "#585b70",
      "thumb_hover": "#6c7086"
    }
  }
}
